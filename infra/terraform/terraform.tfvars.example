aws_region = "us-east-1"

# HuggingFace DLC — change the region in the URI if you are not in us-east-1
sagemaker_image_uri = "763104351884.dkr.ecr.us-east-1.amazonaws.com/huggingface-pytorch-inference:1.13.1-transformers4.26.0-cpu-py39-ubuntu20.04"

min_capacity = 0.5
max_capacity = 1.0

clerk_jwks_url = "https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
clerk_issuer   = "https://your-instance.clerk.accounts.dev"

bedrock_region   = "us-west-2"
bedrock_model_id = "us.amazon.nova-pro-v1:0"

# Leave empty on first apply. After `sam deploy`, set to the HttpApi URL
# (terraform output / SSM /alex/http_api_url) and apply again for CloudFront /api/*.
http_api_url = ""

openai_api_key      = ""
polygon_api_key     = ""
polygon_plan        = "free"
langfuse_public_key = ""
langfuse_secret_key = ""
langfuse_host       = "https://cloud.langfuse.com"
